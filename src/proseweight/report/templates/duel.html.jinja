<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Phrasing duel</title>
<style>
  :root{
    --ink:#0e1f1e;--muted:#5b6f71;--faint:#8aa0a1;--panel:#eef3f2;--card:#ffffff;
    --line:#d3e0df;--grid:#e4edec;--teal:#155263;--teal-bright:#1e8fa8;
    --win:#155263;--lose:#a6bbbd;--amber:#a8791f;
    --sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    --mono:ui-monospace,"Cascadia Code","SF Mono",Consolas,"Liberation Mono",monospace;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--panel);color:var(--ink);font-family:var(--sans);line-height:1.45;-webkit-font-smoothing:antialiased;}
  .wrap{max-width:880px;margin:0 auto;padding:0 20px 60px;}
  header{background:var(--teal);color:#dff0f2;margin:0 -20px;padding:13px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;}
  .mark{font-family:var(--mono);font-weight:600;letter-spacing:.14em;font-size:.82rem;text-transform:uppercase;}
  .mark b{color:#fff}
  .brandmark{display:flex;align-items:center;gap:12px;}
  .logotile{flex:none;width:40px;height:40px;border-radius:7px;background:#eef4f3;display:flex;align-items:center;justify-content:center;}
  .logotile img{width:30px;height:30px;display:block}
  .bt{display:flex;flex-direction:column;line-height:1.08;}
  .bt b{font-weight:700;font-size:.94rem;letter-spacing:.055em;text-transform:uppercase;color:#fff;}
  .bt i{font-family:var(--mono);font-style:normal;font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:#a9d2da;margin-top:2px;}
  .tag{font-family:var(--mono);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:#a9d2da;}

  .panel{background:var(--card);border:1px solid var(--line);border-top:none;padding:26px clamp(16px,4vw,40px) 34px;}
  .eyebrow{font-family:var(--mono);font-size:.7rem;letter-spacing:.13em;text-transform:uppercase;color:var(--faint);border-bottom:1px solid var(--grid);padding-bottom:12px;margin-bottom:22px;display:flex;flex-wrap:wrap;gap:6px 18px;}
  .eyebrow b{color:var(--muted);font-weight:600}

  .banner{text-align:center;margin:6px 0 26px;}
  .banner .v{font-family:var(--mono);font-weight:700;font-size:1.7rem;letter-spacing:.02em;text-transform:uppercase;color:var(--teal);}
  .banner.tie .v{color:var(--amber)}
  .banner .s{color:var(--muted);font-size:.9rem;margin-top:4px;}

  .cards{display:grid;grid-template-columns:1fr auto 1fr;gap:16px;align-items:stretch;}
  .card{border:1px solid var(--line);border-radius:3px;padding:16px 18px;background:#fbfdfd;position:relative;}
  .card.win{border-color:var(--teal);box-shadow:0 0 0 1px var(--teal), 0 6px 20px -12px rgba(21,82,99,.5);}
  .card.lose{opacity:.72}
  .card .side{font-family:var(--mono);font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;color:var(--faint);}
  .card .sc{font-family:var(--mono);font-weight:600;font-size:2.4rem;line-height:1;color:var(--ink);font-variant-numeric:tabular-nums;margin:6px 0 2px;}
  .card.win .sc{color:var(--teal)}
  .card .scl{font-family:var(--mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);}
  .card .ph{font-family:var(--mono);font-size:.84rem;color:#26403f;margin-top:12px;border-top:1px solid var(--grid);padding-top:10px;overflow-wrap:anywhere;}
  .card .crown{position:absolute;top:-10px;right:14px;background:var(--teal);color:#fff;font-family:var(--mono);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;padding:2px 7px;border-radius:2px;}
  .vs{align-self:center;font-family:var(--mono);font-weight:700;font-size:.9rem;color:var(--faint);letter-spacing:.1em;}

  .h2h{margin:26px 0 4px;}
  .h2h .cap{font-family:var(--mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);margin-bottom:6px;display:flex;justify-content:space-between;}
  .bar{display:flex;height:26px;border-radius:3px;overflow:hidden;border:1px solid var(--line);font-family:var(--mono);font-size:.72rem;color:#fff;}
  .bar .a{background:var(--teal);display:flex;align-items:center;padding:0 8px;}
  .bar .b{background:var(--lose);color:#26403f;display:flex;align-items:center;justify-content:flex-end;padding:0 8px;}

  .meta{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:24px;}
  .stat{border:1px solid var(--grid);border-radius:3px;padding:11px 13px;}
  .stat .k{font-family:var(--mono);font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);}
  .stat .val{font-family:var(--mono);font-weight:600;font-size:1.1rem;color:var(--ink);margin-top:3px;font-variant-numeric:tabular-nums;}
  footer{font-family:var(--mono);font-size:.66rem;letter-spacing:.06em;text-transform:uppercase;color:var(--faint);margin-top:18px;text-align:center;}
  @media (max-width:560px){.cards{grid-template-columns:1fr}.vs{padding:6px 0}.meta{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    {% if brand %}
    <span class="brandmark">{% if lion_uri %}<span class="logotile"><img src="{{ lion_uri }}" alt="Fortitude Omnis Group"></span>{% endif %}<span class="bt"><b>{{ brand_name }}</b><i>{{ brand_tagline }}</i></span></span>
    {% else %}
    <span class="mark">Prose Weight <b>· Duel</b></span>
    {% endif %}
    <span class="tag">Phrasing duel</span>
  </header>

  <section class="panel">
    <div class="eyebrow">
      <span>Duel</span><span>suite <b>{{ suite_version }}</b></span>{% if model %}<span>model <b>{{ model }}</b></span>{% endif %}
      <span>ablation-led</span>
    </div>

    <div class="banner {% if not decisive %}tie{% endif %}">
      <div class="v">{{ verdict_label }}</div>
      <div class="s">{% if decisive %}{{ p_out }}% posterior probability the difference is real (outside the region of practical equivalence){% else %}the difference does not clear the region of practical equivalence, so neither phrasing wins{% endif %}</div>
    </div>

    <div class="cards">
      <div class="card {% if a.won %}win{% elif decisive %}lose{% endif %}">
        {% if a.won %}<span class="crown">Winner</span>{% endif %}
        <div class="side">Phrasing {{ a.label }}</div>
        <div class="sc">{{ a.score }}</div><div class="scl">compliance</div>
        <div class="ph">{{ a.text }}</div>
      </div>
      <div class="vs">VS</div>
      <div class="card {% if b.won %}win{% elif decisive %}lose{% endif %}">
        {% if b.won %}<span class="crown">Winner</span>{% endif %}
        <div class="side">Phrasing {{ b.label }}</div>
        <div class="sc">{{ b.score }}</div><div class="scl">compliance</div>
        <div class="ph">{{ b.text }}</div>
      </div>
    </div>

    <div class="h2h">
      <div class="cap"><span>Phrasing {{ a.label }}</span><span>share of measured compliance</span><span>Phrasing {{ b.label }}</span></div>
      <div class="bar">
        <div class="a" style="width:{{ a.share }}%">{{ a.score }}</div>
        <div class="b" style="width:{{ b.share }}%">{{ b.score }}</div>
      </div>
    </div>

    <div class="meta">
      <div class="stat"><div class="k">Effect size</div><div class="val">{{ effect }}</div></div>
      <div class="stat"><div class="k">P(difference &gt; ROPE)</div><div class="val">{{ p_out }}%</div></div>
      <div class="stat"><div class="k">ROPE width</div><div class="val">{{ rope }}</div></div>
    </div>

    <footer>Ablation-led · significance judged against the region of practical equivalence · specific to this suite and model</footer>
  </section>
</div>
</body>
</html>
